<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Runtime permission on API 31+; this is what gates registering as an HID peripheral,
         talking to the adapter, and reading bonded device names. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Needed so the "make discoverable" flow works on API 31+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Pre-31 equivalents. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />
    <!-- Genuinely required: a gamepad needs several fingers down at once to be usable at all. -->
    <uses-feature
        android:name="android.hardware.touchscreen.multitouch"
        android:required="true"
        tools:ignore="UnnecessaryRequiredFeature" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blugaemand">

        <!--
            Android 16 ignores fixed screen orientations on large screens unless an app opts out.
            A thumbstick-and-buttons layout has no sensible portrait arrangement, so the opt-out is
            the honest choice here rather than shipping a pad squeezed into a tall window. The
            opt-out stops working at targetSdk 37; a real portrait layout is the long-term fix and
            is tracked in TODO.md.
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_ORIENTATION"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi"
            android:theme="@style/Theme.Blugaemand">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".hid.HidGamepadService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
