# Copy to keystore.properties (gitignored) to sign release builds. All four are required; any
# missing one fails the build rather than quietly producing an unsigned APK.
#
# Create the key first:
#   keytool -genkeypair -v -keystore blugaemand-release.jks -alias blugaemand \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved against the repo root; an absolute path passes through unchanged.
# Keep the .jks off the repo and backed up: a lost key means the app can never be updated in
# place, only reinstalled under a new identity.
#
# Every value can be supplied through the environment instead, which is what CI does:
# BLUGAEMAND_STOREFILE, BLUGAEMAND_STOREPASSWORD, BLUGAEMAND_KEYALIAS, BLUGAEMAND_KEYPASSWORD.
storeFile=blugaemand-release.jks
storePassword=
keyAlias=blugaemand
keyPassword=
